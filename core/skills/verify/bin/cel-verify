#!/usr/bin/env bash
# cel-verify - a VERDICT for a worker's branch, not a prose review.
#
# "Generation is not the bottleneck anymore. Verification is." Delegation here
# is cheap, parallel, ticketed and model-agnostic; verification was a prose
# skill and a `gate: null`. This writes <worktree>/.agent/verdict.json with
# one structured answer per dimension, so collect can print it, land can
# refuse on it, and the dashboard can show it - and so "did the gate pass" is
# a field, not a sentence somebody has to read.
#
#   gate    the repo's configured test command, actually run here, with its
#           exit and the last lines of output
#   tests   whether tests were written BEFORE the implementation - a test-only
#           commit ahead of the first source commit on the branch. Evidence,
#           not enforcement: post-hoc tests pass regardless of correctness,
#           and this makes that visible per branch rather than arguing about it
#   diff    size, so a "one-line fix" that touched forty files is seen
#   checks  CI state on the PR, review decision on the PR (via gh)
#
# Never dies on a missing input: absent gate -> configured=false, no PR ->
# unknown. The verdict is always written; a partial verdict beats none.
set -uo pipefail
: "${CEL_ROOT:=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../../.." && pwd)}"
# shellcheck source=lib/common.sh
. "$CEL_ROOT/lib/common.sh"
GH="${CEL_VERIFY_GH:-gh}"

usage() { die "usage: cel-verify <worktree> [--gate '<cmd>'] [--gate-timeout <secs>] [--base <ref>] [--slug owner/repo] [--branch b] [--quiet]"; }
[ $# -ge 1 ] || usage
wt="$1"; shift
gate="" base="" slug="" branch="" quiet=0 gate_timeout=""
while [ $# -gt 0 ]; do
  case "$1" in
    --gate) gate="$2"; shift 2;; --base) base="$2"; shift 2;; --slug) slug="$2"; shift 2;;
    --gate-timeout) gate_timeout="$2"; shift 2;;
    --branch) branch="$2"; shift 2;; --quiet) quiet=1; shift;; *) usage;;
  esac
done
# The flag beats the env var so one caller with a slow suite can say so for one
# run, rather than the whole box being reconfigured for its worst repo.
[ -n "$gate_timeout" ] || gate_timeout="${CEL_VERIFY_GATE_TIMEOUT:-600}"
case "$gate_timeout" in ''|*[!0-9]*) die "cel-verify: --gate-timeout must be whole seconds (got: $gate_timeout)";; esac
[ -d "$wt" ] || die "cel-verify: no such worktree: $wt"
git -C "$wt" rev-parse --verify -q HEAD >/dev/null 2>&1 || die "cel-verify: $wt is not a git checkout"

[ -n "$branch" ] || branch="$(git -C "$wt" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
if [ -z "$base" ]; then
  base="$(git -C "$wt" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
  [ -n "$base" ] || base="origin/main"
fi
git -C "$wt" rev-parse --verify -q "$base" >/dev/null 2>&1 || base=""

# --- gate ------------------------------------------------------------------
# A GATE THAT WAITED ITS TURN IS NOT A GATE THAT RAN SLOWLY. The suite takes a
# box-wide lock (tests/run.sh, after six concurrent suites drove this box to a
# load of 190 on 2026-09-18), and the gate this verifier runs is usually that
# suite - so it queues with everyone else. The wait is taken HERE, before the
# timeout clock starts, and recorded: a verdict that took twenty-five minutes
# because twenty of them were spent in a queue is explained by a number rather
# than read as a hang. The lock is a descriptor this process holds, so the
# gate (a child) runs under it and it is released when the gate is done; that
# is the same guarantee `flock <path> -c '<gate>'` gives, minus the second
# open that would make the wait unmeasurable.
_verify_suite_lock_path() {
  if [ -n "${CEL_SUITE_LOCK:-}" ]; then printf '%s' "$CEL_SUITE_LOCK"; return 0; fi
  if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ]; then
    printf '%s/cel-suite.lock' "$XDG_RUNTIME_DIR"; return 0
  fi
  printf '%s/cel-suite-%s.lock' "${TMPDIR:-/tmp}" "${UID:-0}"
}

# A GATE THAT RAN OUT OF TIME IS NOT A GATE THAT FAILED. `timeout` returns 124
# when it killed the command (137 when the kill had to be a SIGKILL). On
# 2026-09-16 the plane's own suite grew past 600 s on a loaded box and a green
# branch was recorded as gate:FAIL - the tail was all `ok` lines, cut off
# mid-run, with no summary - and land correctly refused a verdict that did not
# exist. "Ran out of time" and "the code is wrong" lead to opposite actions and
# must not render alike, the same rule _wt_ahead already states for `?` vs `0`.
g_conf=false g_ran=false g_pass=null g_tail="" g_to=false g_waited=0
if [ -n "$gate" ] && [ "$gate" != "null" ]; then
  g_conf=true; g_ran=true
  suite_lock_fd=""
  suite_lock="$(_verify_suite_lock_path)"
  if [ "$suite_lock" != none ] && command -v flock >/dev/null 2>&1; then
    mkdir -p "$(dirname "$suite_lock")" 2>/dev/null || true
    if exec {suite_lock_fd}>>"$suite_lock"; then
      if ! flock -n "$suite_lock_fd"; then
        lock_t0="$(date +%s)"
        [ "$quiet" -eq 1 ] || printf 'waiting for the suite lock \xe2\x80\xa6\n'
        flock "$suite_lock_fd"
        g_waited=$(( $(date +%s) - lock_t0 ))
      fi
    else
      suite_lock_fd=""
    fi
  fi
  # A KILLED GATE MUST TAKE ITS CHILDREN WITH IT. The same 2026-09-16 run that
  # produced the timeout above also left seven `node tools/pages/server.mjs`
  # processes alive for a hundred minutes: the suite booted them, the timeout
  # ended the suite, and nothing ended them. Reparented to init, they kept
  # every descriptor they had inherited - including the ledger lock of the
  # collect that had spawned this verifier - and blocked the whole workspace.
  # So the gate gets its OWN SESSION (setsid) and the timeout kills the GROUP,
  # escalating to SIGKILL: a single TERM is a request, and a process that is
  # mid-shutdown or ignoring TERM answers it by staying. The group is also
  # swept after a gate that finished, because a gate that passes can still
  # leave a server running, and that server holds the same descriptors.
  gate_out="$(mktemp "${TMPDIR:-/tmp}/cel-verify-gate.XXXXXX")"
  gate_killed="$gate_out.killed"
  ( cd "$wt" && exec setsid bash -lc "$gate" ) > "$gate_out" 2>&1 &
  gate_pid=$!
  ( sleep "$gate_timeout"
    kill -0 "$gate_pid" 2>/dev/null || exit 0
    : > "$gate_killed"
    kill -TERM -- -"$gate_pid" 2>/dev/null || kill -TERM "$gate_pid" 2>/dev/null
  ) > /dev/null 2>&1 &
  gate_watchdog=$!
  rc=0; wait "$gate_pid" || rc=$?
  kill "$gate_watchdog" 2>/dev/null || true
  wait "$gate_watchdog" 2>/dev/null || true
  if [ -e "$gate_killed" ]; then
    rc=124
    rm -f "$gate_killed"
    # TERM has already been delivered and the time is up: nothing in the group
    # gets to negotiate. This is `timeout --kill-after`, applied to the group.
    kill -KILL -- -"$gate_pid" 2>/dev/null || true
  else
    kill -TERM -- -"$gate_pid" 2>/dev/null || true
  fi
  out="$(cat "$gate_out")"; rm -f "$gate_out"
  g_tail="$(printf '%s' "$out" | tail -n 12)"
  case "$rc" in
    0) g_pass=true;;
    124|137)
      g_to=true; g_pass=null
      # the LAST line is where it got to; the sentence after it is why there is
      # nothing after that line.
      g_tail="$(printf '%s' "$out" | tail -n 1)"$'\n'"killed after ${gate_timeout}s - no verdict"
      ;;
    *) g_pass=false;;
  esac
  # Somebody else is waiting on this: hand it over as soon as the gate is
  # done, rather than at the end of the PR and GitHub work below.
  [ -n "$suite_lock_fd" ] && exec {suite_lock_fd}>&-
fi

# --- tests: red then green? --------------------------------------------------
# Walk the branch's commits oldest-first. A commit that touches ONLY test files
# before any commit touching source is red-then-green evidence. null when no
# test file was touched at all.
is_test() { case "$1" in *test*|*spec*|*__tests__*|*.test.*|*.spec.*) return 0;; esac; return 1; }
t_files=0 rg=null rg_detail="no commits past base"
if [ -n "$base" ]; then
  first_test_only="" first_src=""
  n=0
  while read -r sha; do
    [ -n "$sha" ] || continue
    n=$((n+1))
    has_test=0 has_src=0
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      if is_test "$f"; then has_test=1; t_files=$((t_files+1)); else has_src=1; fi
    done < <(git -C "$wt" diff-tree --no-commit-id --name-only -r "$sha" 2>/dev/null)
    [ "$has_test" = 1 ] && [ "$has_src" = 0 ] && [ -z "$first_test_only" ] && first_test_only=$n
    [ "$has_src" = 1 ] && [ -z "$first_src" ] && first_src=$n
  done < <(git -C "$wt" rev-list --reverse "$base..HEAD" 2>/dev/null)
  if [ "$n" -eq 0 ]; then rg_detail="no commits past base"
  elif [ "$t_files" -eq 0 ]; then rg=null; rg_detail="no test files touched in $n commit(s)"
  elif [ -n "$first_test_only" ] && { [ -z "$first_src" ] || [ "$first_test_only" -lt "$first_src" ]; }; then
    rg=true; rg_detail="test-only commit #$first_test_only precedes first source commit${first_src:+ #$first_src}"
  else
    rg=false; rg_detail="tests arrived with or after the implementation (first source commit #$first_src)"
  fi
fi

# --- diff ------------------------------------------------------------------
d_files=0 d_ins=0 d_del=0
if [ -n "$base" ]; then
  read -r d_files d_ins d_del < <(git -C "$wt" diff --shortstat "$base..HEAD" 2>/dev/null \
    | awk '{f=0;i=0;d=0; for(k=1;k<=NF;k++){ if($(k+1)~/^files?/)f=$k; if($(k+1)~/^insertion/)i=$k; if($(k+1)~/^deletion/)d=$k } print f+0, i+0, d+0}')
  : "${d_files:=0}"; : "${d_ins:=0}"; : "${d_del:=0}"
fi

# --- PR: checks + review -------------------------------------------------------
c_state=unknown r_dec=unknown pr_num=null
if [ -n "$slug" ] && [ -n "$branch" ] && command -v "$GH" >/dev/null 2>&1; then
  prj="$("$GH" pr view "$branch" --repo "$slug" --json number,reviewDecision,statusCheckRollup 2>/dev/null || true)"
  if [ -n "$prj" ]; then
    pr_num="$(printf '%s' "$prj" | jq -r '.number // null')"
    r_dec="$(printf '%s' "$prj" | jq -r 'if (.reviewDecision // "") == "" then "NONE" else .reviewDecision end')"
    c_state="$(printf '%s' "$prj" | jq -r '
      [.statusCheckRollup[]? | (.conclusion // .state // "")] as $s
      | if ($s|length)==0 then "NONE"
        elif ($s|map(select(.=="FAILURE" or .=="ERROR"))|length)>0 then "FAILURE"
        elif ($s|map(select(.=="PENDING" or .=="IN_PROGRESS" or .=="QUEUED" or .==""))|length)>0 then "PENDING"
        else "SUCCESS" end')"
  else c_state=NONE; r_dec=NONE; fi
fi

mkdir -p "$wt/.agent"
jq -n --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg branch "$branch" --arg base "$base" \
  --argjson gconf "$g_conf" --arg gcmd "$gate" --argjson gran "$g_ran" --argjson gpass "$g_pass" --arg gtail "$g_tail" \
  --argjson gto "$g_to" --argjson gtos "$gate_timeout" --argjson gwait "$g_waited" \
  --argjson tfiles "$t_files" --argjson rg "$rg" --arg rgd "$rg_detail" \
  --argjson df "$d_files" --argjson di "$d_ins" --argjson dd "$d_del" \
  --arg cs "$c_state" --arg rd "$r_dec" --argjson prn "$pr_num" '
  { at: $at, branch: $branch, base: $base,
    gate:   { configured: $gconf, cmd: $gcmd, ran: $gran, passed: $gpass, tail: $gtail,
              timed_out: $gto, timeout_secs: $gtos, waited_secs: $gwait },
    tests:  { files_touched: $tfiles, red_then_green: $rg, detail: $rgd },
    diff:   { files: $df, insertions: $di, deletions: $dd },
    checks: { state: $cs }, review: { decision: $rd }, pr: $prn }' > "$wt/.agent/verdict.json"

if [ "$quiet" -eq 0 ]; then
  if [ "$g_conf" != true ]; then gs="gate:none"
  elif [ "$g_to" = true ]; then gs="gate:TIMEOUT(${gate_timeout}s)"
  elif [ "$g_pass" = true ]; then gs="gate:PASS"
  else gs="gate:FAIL"; fi
  [ "$g_waited" -gt 0 ] && gs="$gs(queued ${g_waited}s)"
  rs="red-green:$(case "$rg" in true) echo yes;; false) echo no;; *) echo n/a;; esac)"
  printf 'verdict %s  %s  diff:%s files +%s/-%s  checks:%s  review:%s\n' "$gs" "$rs" "$d_files" "$d_ins" "$d_del" "$c_state" "$r_dec"
fi
# exit reflects the gate only: that is the one dimension with a right answer.
# Three outcomes, three codes, so a caller does not have to parse prose: 0 the
# gate passed (or was never configured), 1 it genuinely failed, 2 it ran out of
# time and there is no verdict to act on.
[ "$g_to" = true ] && exit 2
[ "$g_pass" = false ] && exit 1
exit 0
